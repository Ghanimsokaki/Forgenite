# ---------------------------------------------------------------- required
# NVIDIA NIM API key — get a free one at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------- recommended when public
# Protect the whole workspace with a password (published sites /s/* stay public)
FORGENITE_PASSWORD=
# Random string used to sign login sessions (any long random value)
FORGENITE_SESSION_SECRET=

# ---------------------------------------------------------------- 24/7 automations
# Secret for the external heartbeat GET /api/cron?secret=... (Vercel Cron, cron-job.org, GitHub Actions)
# On Vercel, Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically.
CRON_SECRET=
# Where automations, run history and published sites are stored (default ./data)
FORGENITE_DATA_DIR=
# Scheduler tick in seconds (default 20) / max parallel runs (default 2) / run timeout ms (default 600000)
FORGENITE_TICK_SECONDS=
FORGENITE_AUTOMATION_CONCURRENCY=
FORGENITE_AUTOMATION_TIMEOUT_MS=
# Set to "off" to disable the in-process scheduler (e.g. when using only /api/cron)
FORGENITE_SCHEDULER=

# ---------------------------------------------------------------- advanced
# Requests per minute per IP for /api/chat (default 60) and /api/tools (default 90); 0 = unlimited
FORGENITE_RATE_LIMIT=
FORGENITE_TOOL_RATE_LIMIT=
# Extra origins allowed to call the API (comma separated)
FORGENITE_ALLOWED_ORIGINS=
# Any OpenAI-compatible endpoint instead of NVIDIA's (self-hosted NIM, tests)
NVIDIA_BASE_URL=
